{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "code-review-emojis",
  "title": "Code Review Emoji Guide",
  "description": "A simple emoji legend to help convey intention and added meaning in code review comments.",
  "icon": "assets/command-icon.png",
  "author": "almatkai",
  "categories": [
    "Documentation",
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Show Review Emoji",
      "description": "Shows a list of emojis that can be used for code review, in line with the Code Review Emoji Guide.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.code-review-emojis",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/code-review-emojis",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/code-review-emojis",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
